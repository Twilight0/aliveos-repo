# Maintainer: Twilight0 <twilight0@vivaldi.net>
pkgname=orangepi-config
pkgver=0.2.0
pkgrel=5
pkgdesc="Lightweight Urwid TUI configuration and diagnostics utility for Orange Pi Zero (Allwinner H2+/H3)"
arch=('any')
url="https://github.com/Twilight0/orangepi-config"
license=('MIT')
depends=('python' 'python-urwid' 'iw')
optdepends=(
    'ttyd: Remote Web TUI access over browser'
    'wpa_supplicant: Wi-Fi client connection management'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
backup=()

build() {
    cd "$startdir"
    rm -rf dist build *.egg-info
    python -m build --wheel --no-isolation
}

package() {
    cd "$startdir"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Install systemd services and link policies
    install -Dm644 systemd/orangepi-config-web.service "$pkgdir/usr/lib/systemd/system/orangepi-config-web.service"
    install -Dm644 systemd/cpufreq-governor.service "$pkgdir/usr/lib/systemd/system/cpufreq-governor.service"
    install -Dm644 systemd/10-wlan.link "$pkgdir/usr/lib/systemd/network/10-wlan.link"

    # Install documentation and license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    # Install helper scripts
    install -Dm755 scripts/install-jackett.sh "$pkgdir/usr/share/$pkgname/scripts/install-jackett.sh"
    install -Dm755 scripts/install-jackett.sh "$pkgdir/usr/bin/orangepi-install-jackett"
}
